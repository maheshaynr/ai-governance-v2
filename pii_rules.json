    {
      "name": "Credit Card",
      "entity": "CREDIT_CARD",
      "regex": "\\b(?:\\d{4}[- ]?){3}\\d{4}\\b",
      "score": 0.85,
      "is_builtin": false,
      "is_algorithmic": false,
      "is_active": true
    },
    {
      "name": "GEOGRAPHIC_COORDINATES",
      "entity": "GEOGRAPHIC_COORDINATES",
      "regex": "\\b\\d{1,2}(?:\\.\\d+)?\\s*[NS],\\s*\\d{1,3}(?:\\.\\d+)?\\s*[EW]\\b",
      "score": 0.85,
      "is_builtin": false,
      "is_algorithmic": false,
      "is_active": true
    },
    {
      "name": "MIIE_PRIVATE_KEY",
      "entity": "MIIE_PRIVATE_KEY",
      "regex": "-----BEGIN (?:RSA |EC |DSA |OPENSSH |ENCRYPTED )?PRIVATE KEY-----[\\s\\S]*?-----END (?:RSA |EC |DSA |OPENSSH |ENCRYPTED )?PRIVATE KEY-----",
      "score": 0.85,
      "is_builtin": false,
      "is_algorithmic": false,
      "is_active": true
    },
    {
      "name": "INSURANCE_PRIMARY_ID",
      "entity": "INSURANCE_PRIMARY_ID",
      "regex": "\\bXEA[0-9A-Z]+\\b",
      "score": 0.85,
      "is_builtin": false,
      "is_algorithmic": false,
      "is_active": true
    },
    {
      "name": "AutoFix_IBAN_NUMBER",
      "entity": "IBAN_NUMBER",
      "regex": "\\b[A-Z]{2}[0-9]{2}[a-zA-Z0-9]{11,30}\\b",
