  "rules": [
    {
      "name": "Standard_Person_Names",
      "entity": "PERSON",
      "regex": "",
      "score": 0.85,
      "is_builtin": true,
      "is_algorithmic": false,
      "is_active": true
    },
    {
      "name": "Standard_Email_Addresses",
      "entity": "EMAIL_ADDRESS",
      "regex": "",
      "score": 0.85,
      "is_builtin": true,
      "is_algorithmic": false
    },
    {
      "name": "Standard_US_SSN",
      "entity": "US_SSN",
      "regex": "",
      "score": 0.85,
      "is_builtin": true,
      "is_algorithmic": false
    },
    {
      "name": "Indian_Aadhaar_Verhoeff",
      "entity": "IN_AADHAAR",
      "regex": "Python: AadhaarRecognizer()",
      "score": 1.0,
      "is_builtin": false,
      "is_algorithmic": true,
      "is_active": true
    },
    {
      "name": "PoC_Fake_CC",
      "entity": "CREDIT_CARD",
      "regex": "\\b(?:\\d{4}[- ]?){3}\\d{4}\\b",
      "score": 0.85,
      "is_builtin": false,
      "is_algorithmic": false,
      "is_active": true
    },
    {
      "name": "AutoFix_MRN_NUMBER",
      "entity": "MRN_NUMBER",
      "regex": "\\d{4}-[a-zA-Z0-9]+",
      "score": 0.85,
      "is_builtin": false,
      "is_algorithmic": false,
      "is_active": true
    },
    {
      "name": "AutoFix_GEOGRAPHIC_COORDINATES",
      "entity": "GEOGRAPHIC_COORDINATES",
      "regex": "\\b\\d{1,2}(?:\\.\\d+)?\\s*[NS],\\s*\\d{1,3}(?:\\.\\d+)?\\s*[EW]\\b",
      "score": 0.85,
      "is_builtin": false,
      "is_algorithmic": false,
      "is_active": true
    },
    {
      "name": "AutoFix_MIIE_PRIVATE_KEY",
      "entity": "MIIE_PRIVATE_KEY",
      "regex": "-----BEGIN (?:RSA |EC |DSA |OPENSSH |ENCRYPTED )?PRIVATE KEY-----[\\s\\S]*?-----END (?:RSA |EC |DSA |OPENSSH |ENCRYPTED )?PRIVATE KEY-----",
      "score": 0.85,
      "is_builtin": false,
      "is_algorithmic": false,
      "is_active": true
    },
    {
      "name": "AutoFix_INSURANCE_PRIMARY_ID",
      "entity": "INSURANCE_PRIMARY_ID",
      "regex": "\\bXEA[0-9A-Z]+\\b",
      "score": 0.85,
      "is_builtin": false,
      "is_algorithmic": false,
      "is_active": true
    },
    {
      "name": "AutoFix_TRANSACTION_AMOUNT",
      "entity": "TRANSACTION_AMOUNT",
      "regex": "(?:\\$(?:\\d+|\\d{1,3}(?:,\\d{3})+)(?:\\.\\d{2})?|\\b\\d+(?:,\\d{3})*(?:\\.\\d{2})?\\s+dollars\\b)",
      "score": 0.85,
      "is_builtin": false,
      "is_algorithmic": false,
      "is_active": true
    }
  ],
